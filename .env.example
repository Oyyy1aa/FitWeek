APP_NAME=FitWeek
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
APP_MODE=single_user
SINGLE_USER_EMAIL=demo@fitweek.local
SINGLE_USER_DISPLAY_NAME=FitWeek 用户
SINGLE_USER_TIMEZONE=Asia/Shanghai
PERSISTENCE_BACKEND=mysql
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_WORKER_COUNT=2
ORCHESTRATOR_POLL_INTERVAL_SECONDS=0.1
ORCHESTRATOR_LEASE_SECONDS=10
ORCHESTRATOR_HANDLER_TIMEOUT_SECONDS=5
ORCHESTRATOR_REAPER_INTERVAL_SECONDS=1

# Run scripts/setup_mysql94.ps1 to create local URLs securely. Do not commit .env.
# DATABASE_URL=mysql+asyncmy://fitweek_app:<url-encoded-password>@127.0.0.1:<mysql-port>/fitweek?charset=utf8mb4
# TEST_DATABASE_URL=mysql+asyncmy://fitweek_test:<url-encoded-password>@127.0.0.1:<mysql-port>/fitweek_test?charset=utf8mb4
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

REDIS_ENABLED=false
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
TEST_REDIS_URL=redis://:change-me@127.0.0.1:6379/15
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=10
REDIS_KEY_PREFIX=fitweek:dev
TEST_REDIS_KEY_PREFIX=fitweek:test
OBSERVABILITY_ENABLED=true
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER=in_memory
OTEL_SERVICE_NAME=fitweek-api
PROMETHEUS_METRICS_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true
ALERTING_ENABLED=true
ALERT_NOTIFICATION_SINK=in_memory

# Deterministic Context budgets (no model tokenizer is used)
CONTEXT_MAX_CHARACTERS=8000
CONTEXT_MAX_MEMORIES=10
CONTEXT_MAX_BEHAVIOR_ITEMS=10
CONTEXT_DEBUG_API_ENABLED=false

# Deterministic behavior analysis and Recovery Draft settings
BEHAVIOR_SUMMARY_DEFAULT_WINDOW_DAYS=28
BEHAVIOR_SUMMARY_MAX_WINDOW_DAYS=56
BEHAVIOR_SUMMARY_MIN_SIGNAL_OCCURRENCES=3
BEHAVIOR_SUMMARY_REPEAT_RATIO_THRESHOLD=0.60
BEHAVIOR_SUMMARY_MIN_RPE_SAMPLES=2
RECOVERY_DRAFT_TTL_MINUTES=30
RECOVERY_AGENT_ENABLED=true

# Local contract mode. Scripted fake and template fallback never use a key.
MODEL_GATEWAY_ENABLED=true
MODEL_PRIMARY_PROVIDER=scripted-fake
MODEL_BACKUP_PROVIDER=template-fallback
MODEL_REQUEST_TIMEOUT_SECONDS=10
MODEL_CONNECT_TIMEOUT_SECONDS=3
MODEL_MAX_ATTEMPTS=3
MODEL_MAX_CONCURRENCY=4
MODEL_RATE_LIMIT_PER_MINUTE=30
MODEL_MAX_RESPONSE_BYTES=262144
MODEL_TRACE_INCLUDE_USER_CONTENT=false
MODEL_PRIMARY_MODEL=scripted-profile-v1
MODEL_PRIMARY_PROVIDER_VERSION=phase-3a-v1
MODEL_BACKUP_MODEL=scripted-profile-backup-v1
MODEL_BACKUP_PROVIDER_VERSION=phase-3a-v1

# Only set these for an explicitly selected HTTP provider. Never commit real keys.
# MODEL_PRIMARY_BASE_URL=http://127.0.0.1:8011/success
# MODEL_PRIMARY_API_KEY=local-test-key
# MODEL_BACKUP_BASE_URL=http://127.0.0.1:8011/success
# MODEL_BACKUP_API_KEY=local-test-key

# Controlled scheduling. Calendar read is optional and read-only.
SCHEDULE_AGENT_ENABLED=true
SCHEDULE_SLOT_GRANULARITY_MINUTES=15
SCHEDULE_MIN_BUFFER_MINUTES=0
SCHEDULE_MAX_CANDIDATES_PER_SESSION=64
SCHEDULE_MAX_TOTAL_CANDIDATES=512
SCHEDULE_DRAFT_TTL_MINUTES=30
SCHEDULE_BUSY_SNAPSHOT_MAX_AGE_SECONDS=300
CALENDAR_READ_ENABLED=false
CALENDAR_READ_PROVIDER=none
CALENDAR_READ_TIMEOUT_SECONDS=3
CALENDAR_READ_MAX_ATTEMPTS=2
CALENDAR_READ_MAX_RESPONSE_BYTES=131072

# Calendar writes are explicit, disabled by default, and never triggered by ICS.
CALENDAR_WRITE_ENABLED=false
CALENDAR_WRITE_PROVIDER=none
CALENDAR_WRITE_BASE_URL=
CALENDAR_WRITE_API_KEY=
CALENDAR_WRITE_TIMEOUT_SECONDS=3
CALENDAR_WRITE_MAX_ATTEMPTS=3
CALENDAR_WRITE_MAX_RESPONSE_BYTES=131072
# CALENDAR_READ_BASE_URL=http://127.0.0.1:8012
# CALENDAR_READ_API_KEY=local-test-key

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
