        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fitweek_orchestrator_runs_total{outcome=\"FAILED\"}[1h])) / clamp_min(sum(increase(fitweek_orchestrator_runs_total[1h])), 1)",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
