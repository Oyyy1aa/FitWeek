{
  "uid": "fitweek-orchestrator",
  "title": "FitWeek Orchestrator and Workers",
  "description": "Single-process Run, Step, waiting, retry, lease, recovery, and backlog telemetry.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "fitweek",
    "phase-8b2"
  ],
  "templating": {
    "list": [
      {
        "name": "workflow_type",
        "label": "workflow_type",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 2
      },
      {
        "name": "step_type",
        "label": "step_type",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      },
      {
        "name": "outcome",
        "label": "outcome",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs created",
      "type": "stat",
      "description": "Runs created; no business identifiers are exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fitweek_orchestrator_runs_total[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Run completion rate",
      "type": "timeseries",
      "description": "Run completion rate; no business identifiers are exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fitweek_orchestrator_runs_total{outcome=\"COMPLETED\"}[1h])) / clamp_min(sum(increase(fitweek_orchestrator_runs_total[1h])), 1)",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Run failure rate",
      "type": "timeseries",
