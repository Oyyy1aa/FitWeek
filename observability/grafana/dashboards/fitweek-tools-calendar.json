  "description": "Unified Tool Gateway reliability and Calendar read/write business outcomes.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "fitweek",
    "phase-8b2"
  ],
  "templating": {
    "list": [
      {
        "name": "tool_id",
        "label": "tool_id",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 2
      },
      {
        "name": "provider_name",
        "label": "provider_name",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      },
      {
        "name": "outcome",
        "label": "outcome",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      },
      {
        "name": "error_category",
        "label": "error_category",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      },
      {
        "name": "degradation_mode",
        "label": "degradation_mode",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tool invocation rate",
      "type": "stat",
      "description": "Tool invocation rate; no business identifiers are exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool_id) (rate(fitweek_tool_invocations_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
