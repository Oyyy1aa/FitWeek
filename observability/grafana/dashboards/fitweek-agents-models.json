{
  "uid": "fitweek-agents-models",
  "title": "FitWeek Agents and Models",
  "description": "Agent and model rates, bounded failures, fallback, repair, and latency. MODEL TOKEN/COST EXPORT DEFERRED.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "fitweek",
    "phase-8b2"
  ],
  "templating": {
    "list": [
      {
        "name": "agent_type",
        "label": "agent_type",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 2
      },
      {
        "name": "outcome",
        "label": "outcome",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      },
      {
        "name": "provider_name",
        "label": "provider_name",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Agent invocation rate",
      "type": "stat",
      "description": "Agent invocation rate; no business identifiers are exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent_type) (rate(fitweek_agent_runs_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Agent success rate",
      "type": "timeseries",
