{
  "uid": "fitweek-overview",
  "title": "FitWeek Overview",
  "description": "Low-cardinality HTTP, core business, and current reliability health. Environment is process-local.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "fitweek",
    "phase-8b2"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "environment",
        "type": "custom",
        "query": "local",
        "current": {
          "text": "local",
          "value": "local"
        },
        "hide": 2
      },
      {
        "name": "component",
        "label": "component",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      },
      {
        "name": "operation",
        "label": "operation",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      },
      {
        "name": "outcome",
        "label": "outcome",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "stat",
      "description": "HTTP request rate; no business identifiers are exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
