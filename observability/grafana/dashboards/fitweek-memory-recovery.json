{
  "uid": "fitweek-memory-recovery",
  "title": "FitWeek Memory and Recovery",
  "description": "Memory safety counters and deterministic Recovery application outcomes without evidence payloads.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "fitweek",
    "phase-8b2"
  ],
  "templating": {
    "list": [
      {
        "name": "outcome",
        "label": "outcome",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 2
      },
      {
        "name": "component",
        "label": "component",
        "type": "custom",
        "query": "all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Memory queries",
      "type": "stat",
      "description": "Memory queries; no business identifiers are exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fitweek_memory_queries_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory query failure rate",
      "type": "timeseries",
      "description": "Memory query failure rate; no business identifiers are exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fitweek_memory_query_failures_total[5m])) / clamp_min(sum(increase(fitweek_memory_queries_total[5m])), 1)",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
